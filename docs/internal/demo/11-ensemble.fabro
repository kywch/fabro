digraph Ensemble {
    graph [
        goal="Fan out to multiple Codex model routes, then select and summarize the best successful route",
        model_stylesheet="
            #mini    { model: gpt-5.4-mini; reasoning_effort: low; }
            #codex   { model: gpt-5.4;      reasoning_effort: medium; }
            #deep    { model: gpt-5.4;      reasoning_effort: high; }
            #latest  { model: gpt-5.5;      reasoning_effort: high; }
            #synth   { model: gpt-5.5;      reasoning_effort: high; }
        "
    ]
    rankdir=LR

    start [shape=Mdiamond, label="Start"]
    exit  [shape=Msquare, label="Exit"]

    fork [label="Fan Out", shape=component, join_policy="wait_all"]

    mini   [label="Mini",       prompt="Analyze the goal quickly. Provide a concise independent recommendation.", shape=tab]
    codex  [label="Codex",      prompt="Analyze the goal. Provide a thorough independent recommendation. Be precise.", shape=tab]
    deep   [label="Deep Codex", prompt="Analyze the goal carefully. Focus on edge cases, risks, and tradeoffs.", shape=tab]
    latest [label="Latest",     prompt="Analyze the goal with a fresh perspective. Look for alternatives and practical tradeoffs.", shape=tab]

    merge [label="Merge", shape=tripleoctagon]
    synth [label="Summarize Selection", prompt="Use the parallel branch metadata in context. Report which routes succeeded, which route fan-in selected as best, and what to do next if a full prose synthesis is required.", shape=tab]

    start -> fork
    fork -> mini
    fork -> codex
    fork -> deep
    fork -> latest
    mini   -> merge
    codex  -> merge
    deep   -> merge
    latest -> merge
    merge -> synth -> exit
}
