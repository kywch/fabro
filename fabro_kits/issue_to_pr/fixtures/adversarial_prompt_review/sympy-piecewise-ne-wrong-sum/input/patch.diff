 from sympy.core.cache import cacheit
 from sympy.core.compatibility import default_sort_key, range
 from sympy.functions import KroneckerDelta, Piecewise, piecewise_fold
+from sympy.logic.boolalg import And
 from sympy.sets import Interval
 
 
+def _is_linear_in(expr, x):
+    p = expr.as_poly(x)
+    return p is not None and p.degree() <= 1
+
+
+def _condition_covers_delta_range(cond, limit):
+    """
+    Return True if a Piecewise condition generated by ``deltasummation``
+    is known to hold throughout the summation range.
+    """
+    x, a, b = limit
+    args = cond.args if isinstance(cond, And) else (cond,)
+
+    for arg in args:
+        if x not in arg.free_symbols:
+            if arg != True:
+                return False
+            continue
+        if not (arg.is_Relational and _is_linear_in(arg.lhs - arg.rhs, x)):
+            return False
+        if arg.subs(x, a) != True or arg.subs(x, b) != True:
+            return False
+    return True
+
+
+def _eval_delta_piecewise_sum(f, limit):
+    """
+    Sum Piecewise results produced by a previous KroneckerDelta summation.
+
+    ``deltasummation`` represents a finite delta sum as a Piecewise whose
+    condition says whether the free delta index lies in the summation range.
+    If a later summation is over exactly such an index range, the condition is
+    true for every term and the Piecewise can be collapsed.
+    """
+    if not isinstance(f, Piecewise) or len(f.args) != 2:
+        return None
+
+    expr, cond = f.args[0].expr, f.args[0].cond
+    default_expr, default_cond = f.args[1].expr, f.args[1].cond
+    if default_expr is not S.Zero or default_cond != True:
+        return None
+    if limit[0] in expr.free_symbols:
+        return None
+    if not _condition_covers_delta_range(cond, limit):
+        return None
+    return expr*(limit[2] - limit[1] + 1)
+
+
 @cacheit
 def _expand_delta(expr, index):
     """
