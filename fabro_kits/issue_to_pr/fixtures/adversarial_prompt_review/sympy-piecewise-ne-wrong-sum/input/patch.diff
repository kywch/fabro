+def test_Identity_symbolic_entries():
+    i, j = symbols('i j', integer=True)
+    n = symbols('n', integer=True, positive=True)
+    In = Identity(n)
+
+    assert In[0, 0] == S.One
+    assert In[0, 1] == S.Zero
+    assert In[i, i] == S.One
+    assert In[i, j] == KroneckerDelta(i, j)
+    assert In[0, i] == KroneckerDelta(0, i)
+    assert In[i, 0] == KroneckerDelta(0, i)
+
+    assert Sum(In[0, i], (i, 0, n - 1)).doit() == S.One
+    assert Sum(In[i, 0], (i, 0, n - 1)).doit() == S.One
+
+def test_Identity_symbolic_sum_after_refine_orthogonal():
+    from sympy import assuming
+
+    i, j = symbols('i j', integer=True)
+    n = symbols('n', integer=True, positive=True)
+    M = MatrixSymbol('M', n, n)
+
+    with warnings.catch_warnings():
+        warnings.simplefilter("ignore", DeprecationWarning)
+        with assuming(Q.orthogonal(M)):
+            e = refine((M.T*M).doit())
+
+    total = Sum(Sum(e[i, j], (i, 0, n - 1)), (j, 0, n - 1)).doit()
+    assert total == n
+
