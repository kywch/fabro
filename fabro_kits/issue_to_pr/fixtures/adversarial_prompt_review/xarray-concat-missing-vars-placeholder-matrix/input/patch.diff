+def _calc_concat_ordered_names(datasets):
+    ordered = []
+    seen = set()
+    for ds in datasets:
+        for name in ds.variables:
+            if name not in seen:
+                ordered.append(name)
+                seen.add(name)
+    return ordered
+
+
+def _missing_concat_var(template, dim, dim_len, fill_value):
+    dims = template.dims
+    shape = []
+    for d, size in zip(template.dims, template.shape):
+        shape.append(dim_len if d == dim else size)
+
+    if fill_value is dtypes.NA:
+        dtype, fill_value = dtypes.maybe_promote(template.dtype)
+    else:
+        dtype = dtypes.result_type(template.dtype, fill_value)
+
+    if isinstance(template.data, dask_array_type):
+        import dask.array
+
+        chunks = []
+        for d, chunk in zip(template.dims, template.data.chunks):
+            chunks.append((dim_len,) if d == dim else chunk)
+        data = dask.array.full(shape, fill_value, dtype=dtype, chunks=tuple(chunks))
+    else:
+        data = np.full(shape, fill_value, dtype=dtype)
+    return Variable(dims, data, attrs=template.attrs, encoding=template.encoding)
+
