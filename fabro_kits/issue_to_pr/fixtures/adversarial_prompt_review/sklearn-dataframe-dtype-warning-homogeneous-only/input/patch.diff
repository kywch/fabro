+def test_check_array_pandas_dataframe_dtype_warning():
+    # check that pandas dataframes with homogeneous dtype objects warn
+    # when converted
+    try:
+        import pandas as pd
+    except ImportError:
+        raise SkipTest("Pandas not found")
+
+    X = pd.DataFrame([[1, 2, 3], [2, 3, 4]], dtype=object)
+    warning_msg = "Data with input dtype object was converted to float64."
+    X_checked = assert_warns_message(DataConversionWarning, warning_msg,
+                                     check_array, X, warn_on_dtype=True)
+    assert_equal(X_checked.dtype, np.float64)
+
+    warning_msg = ("Data with input dtype object was converted to float64 "
+                   "by SomeEstimator.")
+    X_checked = assert_warns_message(DataConversionWarning, warning_msg,
+                                     check_array, X, warn_on_dtype=True,
+                                     estimator="SomeEstimator")
+    assert_equal(X_checked.dtype, np.float64)
+
+
