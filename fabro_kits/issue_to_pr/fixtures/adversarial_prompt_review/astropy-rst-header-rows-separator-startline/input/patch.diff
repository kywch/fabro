@@ -2,7 +2,9 @@
 
 from io import StringIO
 
+import astropy.units as u
 from astropy.io import ascii
+from astropy.table import QTable
 
 from .common import assert_almost_equal, assert_equal
 
@@ -185,3 +187,42 @@ Col1      Col2 Col3 Col4
 ==== ========= ==== ====
 """,
     )
+
+
+def test_write_header_rows():
+    """Write a SimpleRST table with additional header rows."""
+    tbl = QTable({"wave": [350, 950] * u.nm, "response": [0.7, 1.2] * u.count})
+    out = StringIO()
+    tbl.write(out, format="ascii.rst", header_rows=["name", "unit"])
+    assert_equal_splitlines(
+        out.getvalue(),
+        """\
+===== ========
+ wave response
+   nm       ct
+===== ========
+350.0      0.7
+950.0      1.2
+===== ========
+""",
+    )
+
+
+def test_read_header_rows():
+    """Read a SimpleRST table with additional header rows."""
+    table = """\
+===== ========
+ wave response
+   nm       ct
+===== ========
+350.0      0.7
+950.0      1.2
+===== ========
+"""
+    reader = ascii.get_reader(Reader=ascii.RST, header_rows=["name", "unit"])
+    dat = reader.read(table)
+    assert_equal(dat.colnames, ["wave", "response"])
+    assert_equal(dat["wave"].unit, u.nm)
+    assert_equal(dat["response"].unit, u.count)
+    assert_equal(len(dat), 2)
+    assert_equal(dat["wave"][0], 350.0)
